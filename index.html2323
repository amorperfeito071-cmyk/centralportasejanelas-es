  <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 2.7C8.7 2.7 2.8 8.6 2.8 15.9c0 2.7.8 5.2 2.2 7.3L2.7 29.3l6.3-2.2c2 1.3 4.4 2 7 2 7.3 0 13.2-5.9 13.2-13.2S23.3 2.7 16 2.7zm0 24.1c-2.3 0-4.4-.7-6.2-1.9l-.4-.3-3.7 1.3 1.3-3.6-.3-.4c-1.3-1.8-2-4-2-6.2 0-6.2 5.1-11.3 11.3-11.3S27.3 9.7 27.3 15.9 22.2 26.8 16 26.8zm6.2-8.4c-.3-.2-2-1-2.3-1.1-.3-.1-.5-.2-.8.2-.2.3-.9 1.1-1.1 1.3-.2.2-.4.3-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.3-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.6.1-.2 0-.5 0-.7-.1-.2-.8-1.9-1.1-2.6-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.6.1-.9.4-.3.3-1.2 1.2-1.2 2.9s1.2 3.3 1.4 3.6c.2.3 2.5 3.8 6 5.3.8.4 1.5.6 2 .7.8.3 1.6.2 2.2.2.7-.1 2-.9 2.3-1.7.3-.8.3-1.5.2-1.7-.1-.2-.3-.3-.6-.5z"/></svg>
</a>

<script>
const WA = "5547988932096";
const WA_MSG = "Olá! Vim pelo site da Vanin Portas e Janelas e quero um orçamento.";
const wa = (t) => "https://wa.me/" + WA + "?text=" + encodeURIComponent(t || WA_MSG);
["wa-nav","wa-hero","wa-team","wa-about","wa-contact","wa-float"].forEach(id => { const el = document.getElementById(id); if (el) el.href = wa(); });
document.querySelectorAll("[data-wa]").forEach(a => a.href = wa());
document.getElementById("yr").textContent = new Date().getFullYear();

const PRODUCTS = [
  {id:"1",name:"Porta de Entrada em Madeira Maciça",category:"Portas",price:1890,tag:"Mais vendida",desc:"Porta de entrada robusta em madeira maciça, envernizada e pronta para instalar. Presença e segurança para a fachada da sua casa.",spec:"Madeira maciça selecionada",img:"https://images.unsplash.com/photo-1776632001065-ad9efe3ee60e?crop=entropy&cs=srgb&fm=jpg&q=85&w=900"},
  {id:"2",name:"Porta Pivotante de Design",category:"Portas",price:3200,tag:"Sob medida",desc:"Porta pivotante de grande vão com painel reforçado. Um statement de design para entradas principais.",spec:"Abertura pivotante",img:"https://images.unsplash.com/photo-1670455489403-e33fb9ba84be?crop=entropy&cs=srgb&fm=jpg&q=85&w=900"},
  {id:"3",name:"Porta de Correr com Vidro Temperado",category:"Portas",price:2450,tag:null,desc:"Porta de correr com vidro temperado e trilhos de aço. Conecta ambientes com leveza e vedação acústica.",spec:"Vidro temperado",img:"https://images.unsplash.com/photo-1617307074423-6344f18d357f?crop=entropy&cs=srgb&fm=jpg&q=85&w=900"},
  {id:"4",name:"Janela de Correr em Madeira",category:"Janelas",price:980,tag:null,desc:"Janela de correr clássica em madeira com caixilhos firmes e manutenção simples. Ventilação com charme.",spec:"Caixilhos em madeira",img:"https://images.unsplash.com/photo-1616472992666-a0abcd339f32?crop=entropy&cs=srgb&fm=jpg&q=85&w=900"},
  {id:"5",name:"Janela com Caixilho Rústico",category:"Janelas",price:1150,tag:null,desc:"Janela com caixilho rústico envernizado, feita sob medida para casas de campo e arquitetura acolhedora.",spec:"Estilo rústico",img:"https://images.unsplash.com/photo-1632164661434-505c7a17b228?crop=entropy&cs=srgb&fm=jpg&q=85&w=900"},
  {id:"6",name:"Caixilho Fixo Sob Medida",category:"Caixilhos",price:620,tag:null,desc:"Caixilho fixo com formato personalizado, ideal para claraboias e vãos iluminados de qualquer ângulo.",spec:"Formato personalizado",img:"https://images.unsplash.com/photo-1776624383602-6e187f5bf311?crop=entropy&cs=srgb&fm=jpg&q=85&w=900"},
  {id:"7",name:"Portão de Correr em Madeira",category:"Portões",price:5400,tag:"Sob medida",desc:"Portão de correr de grande vão com estrutura reforçada e ferragens galvanizadas para propriedades.",spec:"Estrutura reforçada",img:"https://images.unsplash.com/photo-1768998049011-5b4dd1575ad3?crop=entropy&cs=srgb&fm=jpg&q=85&w=900"},
  {id:"8",name:"Portão Basculante para Garagem",category:"Portões",price:4800,tag:null,desc:"Portão basculante em madeira maciça com contrapeso equilibrado e acionamento suave no dia a dia.",spec:"Acionamento suave",img:"https://images.unsplash.com/photo-1648941416478-319d8c2d06d4?crop=entropy&cs=srgb&fm=jpg&q=85&w=900"}
];

const brl = (v) => v.toLocaleString("pt-BR", { style: "currency", currency: "BRL", minimumFractionDigits: 0, maximumFractionDigits: 2 });

// marquee (renderiza cada item uma vez por loop)
const MQ = ["Portas sob medida","Janelas em madeira","Portões de correr","Caixilhos","Fabricação própria","Indaial – SC","Entrega e instalação"];
document.getElementById("marquee-track").innerHTML =
  [0,1].map(c => MQ.map(i => `<span ${c===1?'aria-hidden="true"':''}>${i}</span>`).join("")).join("");

// catálogo
let filter = "Todos";
const FILTERS = ["Todos","Portas","Janelas","Portões","Caixilhos"];
function renderFilters(){
  document.getElementById("filters").innerHTML = FILTERS.map(f =>
    `<button class="${f===filter?'on':''}" data-f="${f}">${f}</button>`).join("");
  document.querySelectorAll("#filters button").forEach(b => b.onclick = () => { filter = b.dataset.f; renderFilters(); renderProds(); });
}
function renderProds(){
  const list = filter === "Todos" ? PRODUCTS : PRODUCTS.filter(p => p.category === filter);
  document.getElementById("prods").innerHTML = list.map(p => `
    <article class="prod rv in">
      <div class="ph"><img src="${p.img}" alt="${p.name} — fabricação Vanin Portas e Janelas, Indaial SC" loading="lazy" />${p.tag ? `<span class="tag">${p.tag}</span>` : ""}</div>
      <div class="bd">
        <span class="cat">${p.category}</span>
        <h3>${p.name}</h3>
        <p class="desc">${p.desc}</p>
        <p class="spec">${p.spec}</p>
        <div class="price"><small>a partir de</small><strong>${brl(p.price)}</strong></div>
        <button data-add="${p.id}">🛒 Adicionar ao carrinho</button>
      </div>
    </article>`).join("");
  document.querySelectorAll("[data-add]").forEach(b => b.onclick = () => addToCart(b.dataset.add));
}

// carrinho
let cart = [];
try { cart = JSON.parse(localStorage.getItem("vanin_cart")) || []; } catch(e) {}
const save = () => localStorage.setItem("vanin_cart", JSON.stringify(cart));
const total = () => cart.reduce((s,i) => s + i.price * i.qty, 0);
const count = () => cart.reduce((s,i) => s + i.qty, 0);

function addToCart(id){
  const p = PRODUCTS.find(x => x.id === id);
  const f = cart.find(i => i.id === id);
  if (f) f.qty++; else cart.push({ id: p.id, name: p.name, price: p.price, img: p.img, qty: 1 });
  save(); updateBadge(); openDrawer();
}
function updateBadge(){
  const n = count();
  const badge = document.getElementById("cart-count");
  badge.textContent = n; badge.style.display = n ? "grid" : "none";
  document.getElementById("drawer-title").textContent = n ? `Seu carrinho (${n})` : "Seu carrinho";
}
function renderCart(){
  const bd = document.getElementById("drawer-bd"), ft = document.getElementById("drawer-ft");
  if (!cart.length){
    bd.innerHTML = `<div class="empty"><strong class="serif" style="font-size:24px;font-weight:300">Seu carrinho está vazio</strong><p style="color:rgba(34,21,7,.6);font-size:14px">Explore o catálogo e adicione portas, janelas ou portões para montar seu pedido.</p><a href="#produtos" class="btn btn-amber" onclick="closeDrawer()">Ver produtos →</a></div>`;
    ft.innerHTML = ""; return;
  }
  bd.innerHTML = cart.map(i => `
    <div class="cart-item">
      <img src="${i.img}" alt="${i.name}" />
      <div style="flex:1">
        <strong style="font-size:14px">${i.name}</strong>
        <p class="mono" style="font-size:12px;color:rgba(34,21,7,.6);margin-top:2px">${brl(i.price)}</p>
        <div class="qty">
          <button aria-label="Diminuir" onclick="qty('${i.id}',-1)">−</button>
          <span class="mono" style="font-size:14px;width:20px;text-align:center">${i.qty}</span>
          <button aria-label="Aumentar" onclick="qty('${i.id}',1)">+</button>
          <button class="rm" aria-label="Remover" onclick="rm('${i.id}')">🗑</button>
        </div>
      </div>
    </div>`).join("");
  ft.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center">
      <span class="mono" style="font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:rgba(34,21,7,.5)">Subtotal estimado</span>
      <strong class="serif" style="font-size:26px;font-weight:300">${brl(total())}</strong>
    </div>
    <p style="font-size:11px;color:rgba(34,21,7,.5);margin:6px 0 14px">Orçamento final confirmado no atendimento, conforme medidas e acabamento.</p>
    <button class="btn btn-amber" style="width:100%;justify-content:center;border-radius:14px" onclick="showForm()">Continuar para o pedido →</button>`;
}
window.qty = (id,d) => { const i = cart.find(x => x.id === id); i.qty = Math.max(1, i.qty + d); save(); renderCart(); updateBadge(); };
window.rm = (id) => { cart = cart.filter(x => x.id !== id); save(); renderCart(); updateBadge(); };

// checkout
const DELIVERY = ["Entrega e instalação","Retirada no galpão"];
const PAYMENTS = ["Pix","Cartão","Dinheiro"];
let delivery = DELIVERY[0], payment = PAYMENTS[0];
window.showForm = () => {
  document.getElementById("drawer-title").textContent = "Finalizar pedido";
  document.getElementById("drawer-bd").innerHTML = `
    <form id="co-form" onsubmit="return submitOrder(event)">
      <label>Seu nome *</label><input class="field" id="co-name" placeholder="Ex.: João da Silva" required />
      <label>Telefone / WhatsApp *</label><input class="field" id="co-phone" type="tel" placeholder="(47) 90000-0000" required />
      <label>Cidade *</label><input class="field" id="co-city" placeholder="Ex.: Indaial" required />
      <label>Entrega</label>
      ${DELIVERY.map(d => `<label class="radio"><input type="radio" name="d" value="${d}" ${d===delivery?"checked":""} onchange="delivery='${d}'" /><span>${d}</span></label>`).join("")}
      <label>Pagamento (combinado na entrega)</label>
      <div class="payopts">${PAYMENTS.map(p => `<button type="button" class="${p===payment?'on':''}" onclick="payment='${p}';showForm()">${p}</button>`).join("")}</div>
      <label>Observações (medidas, acabamento…)</label>
      <textarea class="field" id="co-notes" rows="3" style="resize:vertical" placeholder="Ex.: porta de 80cm de largura, verniz fosco…"></textarea>
      <div style="display:flex;justify-content:space-between;align-items:center;margin:18px 0 4px">
        <span class="mono" style="font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:rgba(34,21,7,.5)">Total estimado</span>
        <strong class="serif" style="font-size:26px;font-weight:300">${brl(total())}</strong>
      </div>
      <button class="btn btn-wa" style="width:100%;justify-content:center;border-radius:14px;margin-top:8px">Enviar pedido no WhatsApp</button>
      <p id="co-err" style="color:#dc2626;font-size:13px;margin-top:10px;display:none"></p>
    </form>`;
  document.getElementById("drawer-ft").innerHTML = "";
};
window.submitOrder = (e) => {
  e.preventDefault();
  const name = document.getElementById("co-name").value.trim();
  const phone = document.getElementById("co-phone").value.trim();
  const city = document.getElementById("co-city").value.trim();
  const notes = document.getElementById("co-notes").value.trim();
  if (!name || !phone || !city){
    const er = document.getElementById("co-err");
    er.textContent = "Preencha nome, telefone e cidade para continuar."; er.style.display = "block"; return false;
  }
  const lines = ["NOVO PEDIDO — VANIN PORTAS E JANELAS","","Itens:"];
  cart.forEach(i => lines.push(`• ${i.qty}x ${i.name} — ${brl(i.price)} cada`));
  lines.push("", `Total estimado: ${brl(total())}`, "", `Cliente: ${name}`, `Telefone: ${phone}`, `Cidade: ${city}`, `Entrega: ${delivery}`, `Pagamento: ${payment}`);
  if (notes) lines.push(`Observações: ${notes}`);
  window.open(wa(lines.join("\n")), "_blank", "noopener");
  document.getElementById("drawer-title").textContent = "Pedido enviado";
  document.getElementById("drawer-bd").innerHTML = `<div class="empty">
    <span style="width:60px;height:60px;border-radius:50%;background:var(--amber);display:grid;place-items:center;font-size:28px">✓</span>
    <strong class="serif" style="font-size:26px;font-weight:300">Pedido enviado com sucesso!</strong>
    <p style="color:rgba(34,21,7,.6);font-size:14px">Se o WhatsApp não abrir automaticamente, toque no botão abaixo para enviar a mensagem.</p>
    <a class="btn btn-wa" href="${wa(lines.join("\n"))}" target="_blank" rel="noopener">Abrir WhatsApp</a>
    <a class="mono" style="font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:rgba(34,21,7,.5)" href="#produtos" onclick="cart=[];save();renderCart();updateBadge();closeDrawer()">Fazer novo pedido</a>
  </div>`;
  document.getElementById("drawer-ft").innerHTML = "";
  cart = []; save(); updateBadge(); return false;
};

// drawer open/close
const drawer = document.getElementById("drawer"), overlay = document.getElementById("overlay");
function openDrawer(){ renderCart(); drawer.classList.add("on"); overlay.classList.add("on"); document.body.style.overflow = "hidden"; }
function closeDrawer(){ drawer.classList.remove("on"); overlay.classList.remove("on"); document.body.style.overflow = ""; setTimeout(updateBadge, 300); }
window.closeDrawer = closeDrawer;
document.getElementById("open-cart").onclick = openDrawer;
document.getElementById("close-cart").onclick = closeDrawer;
overlay.onclick = closeDrawer;

// nav scrolled + reveal
const tb = document.getElementById("topbar");
addEventListener("scroll", () => tb.classList.toggle("scrolled", scrollY > 40), { passive: true });
const io = new IntersectionObserver((es) => es.forEach(e => { if (e.isIntersecting){ e.target.classList.add("in"); io.unobserve(e.target); } }), { threshold: 0.15 });
document.querySelectorAll(".rv").forEach(el => io.observe(el));

renderFilters(); renderProds(); updateBadge();
</script>
</body>
</html>
